# ============================================================
# ENVIRONMENT CONFIGURATION — LOCAL DEVELOPMENT ONLY
# ============================================================
# WARNING: This is an EXAMPLE file. Copy to .env and CHANGE
# every value below before first run.
#
# Defaults below are insecure and exist ONLY for illustration
# on a development machine with NO network exposure.
#
# For any server accessible over the network:
# - Use strong passwords (16+ characters, mixed case/numbers/symbols)
# - Use unique credentials (not 'postgres' / 'admin')
# - Rotate credentials regularly
# - Use .env.local (add to .gitignore, never commit)
# ============================================================

POSTGRES_DB=warszawa_health
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_PORT=5432

PGADMIN_EMAIL=admin@localhost.pl
PGADMIN_PASSWORD=admin
PGADMIN_PORT=8080
